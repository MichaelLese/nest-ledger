# Copy to .env, chmod 600, and replace the password before starting.
POSTGRES_DB=nest_ledger
POSTGRES_USER=nest_ledger
POSTGRES_PASSWORD=replace-with-a-long-random-password
# For deployment, replace latest with a tested Actual release tag or digest.
ACTUAL_VERSION=latest
ACTUAL_PORT=5006
APP_PORT=3000

# Host CLI URL; Compose uses http://actual-server:5006 inside its network.
ACTUAL_SERVER_URL=http://127.0.0.1:5006
ACTUAL_SERVER_PASSWORD=
# Settings > Advanced > Sync ID (not the local budget ID).
ACTUAL_SYNC_ID=
# Optional: separate end-to-end encryption password.
ACTUAL_BUDGET_PASSWORD=
